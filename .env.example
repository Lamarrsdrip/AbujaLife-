NODE_ENV=production
HOST=127.0.0.1
PORT=3000
MONGODB_URI=
MONGODB_DATABASE=abujalife_prod
PUBLIC_WEB_URL=https://abujacity.life
API_PUBLIC_URL=https://api.abujacity.life
CORS_ORIGINS=https://abujacity.life
# Enable only behind a protected reverse proxy, with no public API port.
TRUST_PROXY=1
# Stable 32-byte hex/base64 encryption key used for server-side secrets.
ABUJALIFE_CONFIG_KEY=
# Optional dedicated X token encryption key. If omitted, ABUJALIFE_CONFIG_KEY is used.
X_TOKEN_ENCRYPTION_KEY=
# X developer app OAuth 2.0 credentials. Configure this callback in the X developer portal:
# https://api.abujacity.life/api/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://api.abujacity.life/api/x/callback
# Optional existing resident username; no future-account auto-claim.
ABUJALIFE_ADMIN_USERNAME=
# Optional Resend delivery for verification and password reset.
RESEND_API_KEY=
EMAIL_FROM=
